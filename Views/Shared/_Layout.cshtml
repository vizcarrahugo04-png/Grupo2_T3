@using LabTrack.Models
@{
    var loggedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(UserRoles.Admin);
    var pageTitle = ViewData["Title"] as string ?? "Panel";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fa" />
    <title>@pageTitle · LabTrack</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-content">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="LabTrack, inicio">
                <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                <span>Lab<span class="brand-accent">Track</span></span>
            </a>
            @if (loggedIn)
            {
                <nav class="desktop-nav" aria-label="Navegación principal">
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Index">Administración</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index">Inicio</a>
                        <a asp-controller="Catalog" asp-action="Index">Catálogo</a>
                        <a asp-controller="Reservations" asp-action="Index">Mis reservas</a>
                    }
                </nav>
                <div class="header-actions">
                    <span class="user-tag">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="text-button" type="submit">Salir</button>
                    </form>
                </div>
            }
        </div>
        @if (loggedIn)
        {
            <nav class="mobile-nav shell" aria-label="Navegación móvil">
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Index">Administración</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    <a asp-controller="Catalog" asp-action="Index">Catálogo</a>
                    <a asp-controller="Reservations" asp-action="Index">Reservas</a>
                }
            </nav>
        }
    </header>

    <main class="shell main-content" id="contenido">
        @if (TempData["Success"] is string success)
        {
            <div class="flash flash-success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="flash flash-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer shell">
        <span>LabTrack · Gestión de laboratorios</span>
        <span>Horario local: Perú (UTC−5)</span>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
